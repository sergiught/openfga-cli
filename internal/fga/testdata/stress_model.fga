model
  schema 1.1

type user

type service_account

type anonymous

type group
  relations
    define admin: [user] or member
    define inherited_member: member or inherited_member from parent
    define member: [user, user:*, service_account, group#member]
    define parent: [group]

type team
  relations
    define lead: [user]
    define member: [user, group#member] or member from parent
    define parent: [team]

type tag
  relations
    define group: [group]

type organization
  relations
    define absurdly_long_relation_name_that_widens_the_card_x: [user] or owner
