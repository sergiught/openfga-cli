        "expectation"
      ],
      "type": "object"
    },
    "CheckRequestTupleKey": {
      "additionalProperties": false,
      "properties": {
        "object": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "user",
        "relation",
        "object"
      ],
      "type": "object"
    },
    "ReadAssertionsResponse": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
