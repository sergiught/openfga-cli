      ],
      "type": "object"
    },
    "TupleKey": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/RelationshipCondition"
        },
        "object": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "user",
        "relation",
        "object"
      ],
      "type": "object"
    }
