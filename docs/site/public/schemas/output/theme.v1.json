{
  "$defs": {
    "list": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "current": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "current"
      ],
      "type": "object"
    },
    "set": {
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string"
        }
      },
      "required": [
        "theme"
      ],
      "type": "object"
    }
  },
  "$id": "https://sergiught.github.io/openfga-cli/schemas/output/theme.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Without an argument, the active theme and the available ones; with a theme name, the theme that was set.",
  "oneOf": [
    {
      "$ref": "#/$defs/list"
    },
    {
      "$ref": "#/$defs/set"
    }
  ],
  "title": "ofga theme --json"
}
