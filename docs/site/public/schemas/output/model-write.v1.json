      "properties": {
        "authorization_model_id": {
          "type": "string"
        }
      },
      "required": [
        "authorization_model_id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "schema_version": {
          "type": "string"
        },
        "type_definitions": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dry_run",
        "schema_version",
        "type_definitions"
      ],
      "type": "object"
    }
  ],
  "title": "ofga model write --json"
}
