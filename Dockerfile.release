# Minimal runtime image built by goreleaser (the binary is prebuilt and copied
# from the build context, so there is no Go toolchain step here).
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk add --no-cache ca-certificates && adduser -D -u 10001 ofga

# goreleaser builds one multi-platform image, staging each platform's binary
# under <os>/<arch>/ in the build context, so the COPY has to be platform-aware.
# TARGETPLATFORM is supplied by buildx.
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/ofga /usr/bin/ofga
COPY LICENSE /usr/share/licenses/ofga/LICENSE
COPY THIRD_PARTY_LICENSES /usr/share/licenses/ofga/THIRD_PARTY_LICENSES

USER ofga
ENTRYPOINT ["/usr/bin/ofga"]
